# (PowerShell: -join ((1..64) | ForEach-Object {'{0:x}' -f (Get-Random -Max 16)}))
MCP_AUTH_TOKEN=

NODE_ENV=production

# Railway injects PORT automatically. Leave blank.
PORT=
